# Copy to apps/web/.env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Supabase (the Vercel ⇄ Supabase integration fills these in; legacy names also accepted:
# NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Claude
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Meta) — Fauve's single number
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
# Any random string, also entered in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
# WhatsApp Business Account ID (Business settings > Accounts > WhatsApp accounts)
WHATSAPP_WABA_ID=
# Supabase → Authentication → Hooks → Send SMS (HTTPS): https://<domain>/api/auth/send-sms
# Paste the generated secret here ("v1,whsec_…")
SEND_SMS_HOOK_SECRET=
# Fauve's number, digits only with country code (wa.me links + landing QR code)
NEXT_PUBLIC_FAUVE_WHATSAPP_NUMBER=

# Secret for the browser test chat (/essai?cle=...) and /api/admin/whatsapp
FAUVE_TEST_KEY=

# Public URL used in links sent on WhatsApp (defaults to the Vercel production URL)
APP_URL=
# Reporting only (cost_events.cost_eur)
USD_TO_EUR=0.86

# Later
GEMINI_API_KEY=
AYRSHARE_API_KEY=
STRIPE_SECRET_KEY=
